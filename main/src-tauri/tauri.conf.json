{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optimal FTO Solver",
  "version": "0.1.0",
  "identifier": "dev.abid.optimal-fto-solver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Optimal FTO Solver",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
