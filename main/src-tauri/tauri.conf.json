{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FTO Alg Finder",
  "version": "0.1.0",
  "identifier": "dev.abid.optimal-fto-solver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FTO Alg Finder",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
